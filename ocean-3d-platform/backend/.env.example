# OceanAI Gemini API Configuration
# Copy this file to .env and fill in your API key

# Your Google Gemini API key (get from https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Gemini model to use (verified available on this key; the previous
# default gemini-3.8-flash is free-tier rate-limited to 20 requests/day)
GEMINI_MODEL=gemini-3.6-flash
